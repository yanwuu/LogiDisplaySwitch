@echo off
title LogiSwitch 硬件通信诊断工具
chcp 936 >nul

echo ==============================================================
echo   LogiSwitch - 罗技键鼠硬件通信诊断 (排查鼠标切通道)
echo ==============================================================
echo.
echo  此工具将:
echo    1. 扫描所有罗技优联/Bolt接收器接口
echo    2. 深度穿透探测槽位并尝试将鼠标切回通道 1 (Mac)
echo    3. 在桌面生成详细报告 LogiSwitch_Report.txt
echo    4. 【注意】此工具不会切换显示器，方便你在屏幕上直观查看诊断！
echo.
pause

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

echo.
echo ==============================================================
echo  请查看 MX Master 3 底部指示灯有没有跳到 1！
echo  桌面上已生成 LogiSwitch_Report.txt 诊断报告。
echo ==============================================================
pause
