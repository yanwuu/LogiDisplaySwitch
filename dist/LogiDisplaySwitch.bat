@echo off
title LogiDisplaySwitch (Windows 后台无感联动工具)

if "%1"=="-test" goto :RUN_TEST
if "%1"=="-uninstall" goto :RUN_UNINSTALL
if "%1"=="-stop" goto :RUN_UNINSTALL

echo ==============================================================
echo   LogiDisplaySwitch - 罗技键鼠显示器双向联动 (Windows 极速单文件版)
echo ==============================================================
echo.
echo  当前配置:
echo    Mac 端: 蓝牙 (通道 1) + 显示器 Type-C (27)
echo    Win 端: 优联/Bolt接收器 (通道 2) + 显示器 DP (16)
echo.
echo  硬件识别已锁定:
echo    - 键盘 MX Keys: 优联槽位 0x01
echo    - 鼠标 MX Master 3: 优联槽位 0x04
echo.
echo  [1] 一键安装并立即在后台静默运行 (开机自启, 无黑框) [推荐]
echo  [2] 立即测试切回 Mac (切鼠标1 + 切显示器Type-C)
echo  [3] 停止并卸载后台服务
echo.
set CHOICE=1
set /p CHOICE="请输入选项 [1/2/3] (默认直接回车安装 1): "
if "%CHOICE%"=="2" goto :RUN_TEST
if "%CHOICE%"=="3" goto :RUN_UNINSTALL

:RUN_INSTALL
echo.
echo 正在安装至 APPDATA 并配置开机自启...
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
echo ==============================================================
echo  [+] 安装成功！极速守护服务已在后台静默启动运行！
echo  [*] 以后电脑开机无需任何操作，自动在后台静默守护。
echo  [*] 本窗口将在 3 秒后自动关闭。
echo ==============================================================
echo.
timeout /t 3 >nul
exit /b

:RUN_TEST
echo.
echo 正在执行测试与硬件诊断...
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
echo [+] 测试脚本执行完毕。
pause
exit /b

:RUN_UNINSTALL
echo.
echo 正在停止后台守护进程并卸载...
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo [+] 后台服务已停止并成功卸载！
pause
exit /b
